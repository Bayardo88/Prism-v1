{
  "name": "@scalar/design-system",
  "version": "1.1.0",
  "description": "Scalar Design System \u2014 React component and design-token layer, generated from the Scalar_Design_System v1.1 Figma libraries.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "default": "./dist/tokens/index.js"
    },
    "./styles.css": "./dist/styles/scalar.css",
    "./charts": {
      "types": "./dist/components/charts/index.d.ts",
      "default": "./dist/components/charts/index.js"
    }
  },
  "files": [
    "dist",
    "AI-GUIDE.md",
    "CLAUDE.md",
    "ONBOARDING.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build:css",
    "prepare": "npm run build",
    "build:css": "node scripts/build-css.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "gen:tokens": "node scripts/gen-tokens.mjs",
    "verify": "npm run typecheck && npm run lint:tokens",
    "build:examples": "tsc -p examples/tsconfig.json",
    "build:product": "tsc -p apps/product/tsconfig.json",
    "product": "npm run build && npm run build:product && node scripts/serve.mjs",
    "product:catalog": "npm run build:product && node scripts/gen-product-catalog.mjs",
    "verify:product": "npm run build:product && npm run lint:tokens && node scripts/gen-product-catalog.mjs",
    "gen:icons": "node scripts/gen-icons.mjs",
    "product:seed": "node apps/product/db/seed.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@material-symbols/svg-400": "^0.47.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "chart.js": "^4.5.1"
  }
}
